# Backend API URL (the Laravel/Express backend that powers the data layer)
BACKEND_URL=http://localhost:8081

# Gemini API Key — required for AI features (description generation, review summaries)
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# App URL — used for absolute redirects (e.g. logout)
APP_URL=http://localhost:3000
